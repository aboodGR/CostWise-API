{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CostWiseSettings": {
    "Currency": "JOD",
    "MaxExpenseAmount": 10000
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=CostWiseAPI;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"
  },
  "JWT": {
    "Key": "put-a-long-random-secret-key-here",
    "Issuer": "CostWiseAPI",
    "Audience": "CostWiseClient",
    "ExpireMinutes": 60
  }
}
